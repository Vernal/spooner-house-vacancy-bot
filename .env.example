# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Hospitable API token — get yours at https://app.hospitable.com/settings/api
HOSPITABLE_API_TOKEN=your_hospitable_api_token_here

# Set to true during testing — Claude checks everything but never sends messages.
# Flip to false (or remove) when you're ready to go live.
DRY_RUN=true
